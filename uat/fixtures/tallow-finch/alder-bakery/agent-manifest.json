{
  "brand": "Alder & Rye Bakery",
  "networks": [
    {
      "name": "alder_bakery",
      "front_man": "bakery_counter",
      "hocon": "./alder_bakery.network.json",
      "description": "Bread, cakes, opening hours and celebration-cake orders at Alder & Rye Bakery.",
      "tags": [
        "agentified-website",
        "small-business"
