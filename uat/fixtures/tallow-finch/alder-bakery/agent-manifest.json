  "peer_policy": {
    "mode": "closed",
    "deny_origins": [],
    "note": "Calls no other site."
  },
  "theme": {
    "primary": "#8a5a2b"
  },
  "deployment": {
    "mode": "static",
    "self_contained_runtime": true,
    "browser_mock": false,
    "direct_byok": true
  }
