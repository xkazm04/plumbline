    "byok_router": "https://api.otari.ai/api/v1"
  },
  "peer_policy": {
    "mode": "closed",
    "deny_origins": [],
    "note": "Calls no other site."
  },
  "theme": {
    "primary": "#6a3b8b",
  },
  "deployment": {
    "mode": "static",
    "self_contained_runtime": true,
    "browser_mock": false,
    "direct_byok": true
  }
