# Response headers for static hosts that read a _headers file (Netlify, Cloudflare Pages). GitHub Pages ignores this
# file; there the Content-Security-Policy <meta> tag in index.html is the policy that applies, and these protections
# are missing. See site/README.md, "Content-Security-Policy".

# Every path: never sniff a type other than the one served (a JSON or text file must not run as script or style), and
# send no referrer on any request or link the Desk makes, so a site it checks never learns which page asked.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

# frame-ancestors works only as a header, never in a <meta> tag. A private key the visitor picks for signing or revoking
# sits in the page's memory until it is used, so no other site may frame the Desk (on hosts that ignore this file,
# desk.js refuses those actions in a frame instead). The AI provider key lives in this tab's sessionStorage, and in
# localStorage only when the visitor ticks "remember" (site.js). The policy is set on the page only:
# bridge/action-bridge.html must stay framable, because other agentic sites load it in a hidden frame.
/
  Content-Security-Policy: frame-ancestors 'none'
/index.html
  Content-Security-Policy: frame-ancestors 'none'

# The coded-tool sandbox worker gets its policy from its own response, not from the page. This is the policy the
# runtime asks for (runtime/sandbox-worker.js); without it the worker refuses to run any peer's coded tool.
/runtime/sandbox-worker.js
  Content-Security-Policy: default-src 'none'; script-src blob:; connect-src 'none'; worker-src 'none'

# The spec requires public agent artifacts to allow cross-origin reads, without credentials: other agentic sites load
# this Desk's network in their visitors' browsers, and verifiers read its signature, key and lock from other origins.
/agent-manifest.json
  Access-Control-Allow-Origin: *
/agent-mcp.json
  Access-Control-Allow-Origin: *
/plumbline_desk.network.json
  Access-Control-Allow-Origin: *
/links.json
  Access-Control-Allow-Origin: *
/plumbline.signature.json
  Access-Control-Allow-Origin: *
/plumbline.lock.json
  Access-Control-Allow-Origin: *
/.well-known/*
  Access-Control-Allow-Origin: *

# A verifier reads EVERY file the signature covers, so each signed code file allows cross-origin reads too: the action
# module, the modules it imports that agent-manifest.json lists under actions.modules, and the bridge. The host answers
# /bridge/action-bridge.html with a redirect to the extensionless path, so both forms carry the header (the bridge stays
# framable: other agentic sites frame it). A file a browser on another origin cannot read is
# "unverifiable" there, never "verified". The revocation path is listed even while the Desk publishes none: a verifier
# that cannot read the 404 cannot tell "no revocation" from "refused", so the Desk could never be verified from there.
/site-actions.js
  Access-Control-Allow-Origin: *
/desk.js
  Access-Control-Allow-Origin: *
/drift.js
  Access-Control-Allow-Origin: *
/examples.js
  Access-Control-Allow-Origin: *
/fetcher.js
  Access-Control-Allow-Origin: *
/review-dialog.js
  Access-Control-Allow-Origin: *
/strings.js
  Access-Control-Allow-Origin: *
/bridge/action-bridge.html
  Access-Control-Allow-Origin: *
/bridge/action-bridge
  Access-Control-Allow-Origin: *
/plumbline-revocation.json
  Access-Control-Allow-Origin: *
